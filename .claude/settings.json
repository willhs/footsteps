{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(poetry run python *)",

      "Bash(scripts/deploy-budgie.sh)",
      "Bash(scripts/deploy-budgie.sh *)",
      "Bash(./scripts/deploy-budgie.sh)",
      "Bash(./scripts/deploy-budgie.sh *)",
      "Bash(GRID_ONLY=1 scripts/deploy-budgie.sh)",
      "Bash(GRID_ONLY=1 ./scripts/deploy-budgie.sh)",
      "Bash(SKIP_TILES=1 scripts/deploy-budgie.sh)",
      "Bash(SKIP_TILES=1 ./scripts/deploy-budgie.sh)",
      "Bash(API_ONLY=1 scripts/deploy-budgie.sh)",
      "Bash(API_ONLY=1 ./scripts/deploy-budgie.sh)",

      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint)",
      "Bash(pnpm run build)",
      "Bash(pnpm run test)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run lint)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run lint)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git pull)",
      "Bash(git pull *)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)"
    ]
  }
}
