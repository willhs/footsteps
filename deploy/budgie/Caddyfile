# Footsteps on budgie: static app + PMTiles, behind the Cloudflare Tunnel.
:80 {
	encode zstd gzip

	# Tiles: one PMTiles archive per year, read with HTTP Range requests.
	# Don't compress (Range offsets must match the file) and let Cloudflare cache.
	handle_path /pmtiles/* {
		root * /srv/pmtiles
		header Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	# Grid and terrain images are regenerated rarely; let repeat visits and Cloudflare reuse them.
	@images path /grid/* /terrain/*
	handle @images {
		root * /srv/app
		header Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		file_server
	}

	handle /api/* {
		reverse_proxy footsteps-api:8000
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		root * /srv/app
		@hashed path /_next/static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
